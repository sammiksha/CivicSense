        <tr><td class="mut">Max Loss Tolerance</td><td><b>${c.loss_tolerance_pct}%</b></td></tr>
        <tr><td class="mut">Investment Horizon</td><td><b>${c.horizon_months} months</b></td></tr>
        <tr><td class="mut">Liquidity Need</td><td>${c.liquidity_need||'medium'}</td></tr>
        <tr><td class="mut">Annual Income</td><td>${c.annual_income_inr ? fmtInr(c.annual_income_inr) : '—'}</td></tr>
      </table>
    </div>
  </div>`;
}

function loadCustomerPortfolio() {
  const c = SELECTED_CUSTOMER || {};
  const el = $('cust-portfolio-content');
  if (!el) return;
  const holdings = c.holdings || [];
  el.innerHTML = `
  <div class="grid-2">
    <div class="card">
      <div class="card-title">Portfolio Summary</div>
      <div class="kpi"><div class="kpi-label">Total Portfolio Value</div><div class="kpi-value">${fmtInr(c.portfolio_value)}</div></div>
      <div class="mt8">
        ${Object.entries(c.existing_exposures||{}).map(([k,v])=>`<div class="flex items-center gap-8 mt4">
          <span class="text-sm" style="flex:1">${k}</span>
          <div style="flex:2;height:8px;background:var(--bg);border-radius:4px;overflow:hidden"><div style="height:100%;width:${v}%;background:var(--pri);border-radius:4px"></div></div>
          <span class="text-sm fw6" style="width:40px;text-align:right">${v}%</span>
        </div>`).join('')}
      </div>
    </div>
    <div class="card">
      <div class="card-title">Holdings</div>
      <table><tr><th>Asset</th><th>Type</th><th>Value</th></tr>
      ${holdings.map(h=>`<tr><td>${h.asset}</td><td class="text-xs">${h.type}</td><td>${fmtInr(h.value)}</td></tr>`).join('')}
      </table>
    </div>
  </div>`;
}

// ══════════════ CUSTOMER COPILOT ══════════════
function custAskPrompt(prompt) {
  const inp = $('cust-q');
  if (inp) inp.value = prompt;
  custAsk();
}

function formatChatMsg(text) {
  if (!text) return '';
  let clean = text.replace(/\[kb:[^\]]+\]/g, '');
  clean = clean.replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');
  clean = clean.replace(/\*([^*]+)\*/g, '<i>$1</i>');
  clean = clean.replace(/\n\n/g, '<br><br>');
  clean = clean.replace(/\n• /g, '<br>• ');
  clean = clean.replace(/\n/g, '<br>');
  return clean;
}

function clearCustChat() {
  SESSION_CHAT_HISTORY = [];
  LAST_CUST_QUERY = '';
  const chat = $('cust-chat');
  if (chat) {
    chat.innerHTML = `
      <div class="chat-msg bot">
        👋 <b>Hello! I am your FinVision AI Assistant.</b><br><br>
        I can explain how your structured investments work in plain, everyday English with no confusing financial jargon.<br><br>
        Feel free to click any suggested question above or type your question below.
      </div>
    `;
  }
}

function retryCustLastQuestion() {
  if (LAST_CUST_QUERY) {
    const inp = $('cust-q');
    if (inp) inp.value = LAST_CUST_QUERY;
    custAsk();
  }
}

async function custAsk() {
  const q = $('cust-q').value.trim();
  if (!q) return;
  LAST_CUST_QUERY = q;
  $('cust-q').value = '';
  const chat = $('cust-chat');
  chat.innerHTML += `<div class="chat-msg user">${q}</div>`;
  chat.innerHTML += `<div class="chat-msg bot" id="bot-latest"><span class="loading" style="padding:0">Thinking...</span></div>`;
  chat.scrollTop = chat.scrollHeight;
  try {
    const cid = SELECTED_CUSTOMER?.id || AUTH?.user?.customer_id || 'C101';
    const activePage = document.querySelector('.page.active')?.id?.replace('page-', '') || 'cust-copilot';
    const pageContext = {
      view: activePage,
      customer_id: cid,
      product: LAST_ASSESSMENT?.result?.product || prod(),
      decision: LAST_ASSESSMENT?.result?.decision || null,
      breaking_point: LAST_ASSESSMENT?.result?.breaking_point?.mismatch_from_pct || null,
      portfolio_concentration: LAST_ASSESSMENT?.result?.rules?.find(r=>r.rule_id==='CONCENTRATION')?.details?.concentration_pct || null
    };

    const payload = {
      session_id: 'cust-' + (AUTH?.user?.id || 'guest'),
      message: q,
      mode: 'client',
      customer_id: cid,
      page_context: pageContext,
      history: SESSION_CHAT_HISTORY.slice(-6)
    };

    const r = await api('/api/v1/copilot', payload);
    const ansText = r.answer || '';
    $('bot-latest').innerHTML = formatChatMsg(ansText);
    $('bot-latest').id = '';

    SESSION_CHAT_HISTORY.push({role: 'user', content: q});
    SESSION_CHAT_HISTORY.push({role: 'assistant', content: ansText});
  } catch(e) {
    $('bot-latest').innerHTML = `<span class="warn-text">Error: ${e.message}</span>`;
    $('bot-latest').id = '';
  }
  chat.scrollTop = chat.scrollHeight;
}

// ══════════════ INIT ══════════════
window.addEventListener('DOMContentLoaded', async () => {
  // Pre-fill RM creds by default
  $('login-email').value = 'rm@finvision.demo';
  $('login-password').value = 'RM@123';
  await tryAutoLogin();
});
</script>
</body>
</html>

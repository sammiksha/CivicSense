        <input type="text" id="rm-cust-search" placeholder="🔍 Search name, ID, city, email..." oninput="filterRMCustomers()" style="padding:7px 12px;border:1.5px solid var(--line);border-radius:6px;font-size:13px;width:240px;outline:none">
        <select id="rm-cust-risk-filter" onchange="filterRMCustomers()" style="padding:7px 10px;border:1.5px solid var(--line);border-radius:6px;font-size:13px;outline:none">
          <option value="all">All Risk Profiles</option>
          <option value="conservative">Conservative</option>
          <option value="moderate">Moderate</option>
          <option value="aggressive">Aggressive</option>
        </select>
      </div>
    </div>
    <div class="grid-3 mt14" id="rm-cust-kpis" style="margin-bottom:14px"></div>
    <div class="card">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
        <span>Assigned Client Portfolios</span>
        <span class="badge INFO" id="rm-cust-count-badge" style="font-size:11px"></span>
      </div>
      <div id="rm-cust-detail-table"></div>
    </div>
    <div id="rm-cust-dossier" style="display:none" class="mt14"></div>
  </div>

  <div id="page-rm-studio" class="page">
    <div class="section-header"><div class="section-title">Product Studio</div></div>
    <div class="two-col">
      <div>
        <div class="card">
          <div class="card-title">Customer</div>
          <div class="form-group"><label>Select Customer</label>
            <select id="rm-sel-cust" onchange="rmSelectCustomer()"></select>
          </div>
          <div id="rm-cust-info" class="text-sm mut mt8"></div>
        </div>
        <div class="card">
          <div class="card-title">Product Configuration</div>
          <div class="form-group"><label>Product Type</label>
            <select id="p-type" onchange="onProductTypeChange();livePayoff()">
              <option>ELN</option><option>DCD</option><option>CPN</option>
            </select>
          </div>
          <div class="form-group"><label>Underlying</label>
            <select id="p-under" onchange="livePayoff()"><option>NIFTY 50</option><option>USDINR</option></select>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Tenor (months)</label><input id="p-tenor" type="number" value="12" min="1" max="120" onchange="livePayoff()"></div>
            <div class="form-group"><label>Coupon / Interest %</label><input id="p-coupon" type="number" value="12" min="0" onchange="livePayoff()"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Strike %</label><input id="p-strike" type="number" value="100" onchange="livePayoff()"></div>
            <div class="form-group"><label>Notional (₹)</label><input id="p-notional" type="number" value="1000000" onchange="livePayoff()"></div>
          </div>
          <div id="eln-fields">
            <div class="form-group"><label>Barrier %: <b id="bv">70</b></label>
              <input id="p-barrier" type="range" min="30" max="95" value="70" oninput="$('bv').textContent=this.value;livePayoff()">
            </div>
          </div>
          <div id="cpn-fields" style="display:none">
            <div class="form-row">
              <div class="form-group"><label>Protection %</label><input id="p-prot" type="number" value="90" min="0" max="100" onchange="livePayoff()"></div>
              <div class="form-group"><label>Participation %</label><input id="p-part" type="number" value="100" min="0" max="500" onchange="livePayoff()"></div>
            </div>
          </div>
          <div class="form-group mt8"><label>Upload Term Sheet (PDF/TXT)</label><input type="file" id="ts-file" accept=".pdf,.txt"></div>
          <div class="form-group"><label>...or describe in plain language</label><textarea id="ts-nl" rows="2" placeholder="One-year NIFTY note, 12% coupon, 70% barrier, 10 lakh"></textarea></div>
          <div class="flex gap-8 wrap mt8">
            <button class="btn btn-secondary btn-sm" onclick="extractProduct()">Extract & Validate</button>
            <button class="btn btn-secondary btn-sm" onclick="applyProductConfig()">Apply Product</button>
            <button class="btn btn-secondary btn-sm" onclick="saveProductConfig()">Save</button>
            <button class="btn btn-secondary btn-sm" onclick="resetProductConfig()">Reset</button>
            <button class="btn btn-secondary btn-sm" onclick="scrollToPayoff()">View Payoff</button>
            <button class="btn btn-secondary btn-sm" onclick="scrollToScenarios()">View Scenarios</button>
          </div>
          <div id="ex-msg" class="text-sm mut mt8"></div>
          <button class="btn btn-primary btn-full mt14" onclick="runAssessment()">Run Analysis & Full Assessment</button>
        </div>
      </div>
      <div>
        <div class="card"><div class="card-title">Payoff at Maturity <span class="text-xs mut">(drag barrier to update)</span></div>
          <div id="payoff-chart" style="height:280px"></div>
          <div id="payoff-scenarios" class="mt8"></div>
        </div>
        <div class="card" id="studio-result-card" style="display:none">
          <div class="card-title">Assessment Result</div>
          <div id="studio-result"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="page-rm-analysis" class="page">
    <div class="section-header"><div class="section-title">Assessment Detail</div></div>
    <div id="rm-analysis-content"><div class="empty">Run an assessment from Product Studio first.</div></div>
  </div>

  <div id="page-rm-stress" class="page">
    <div class="section-header"><div class="section-title">Stress & Regime Analysis</div></div>
    <div id="rm-stress-content"><div class="empty">Run an assessment first.</div></div>
  </div>

  <div id="page-rm-portfolio" class="page">
    <div class="section-header"><div class="section-title">Portfolio Impact</div></div>
    <div id="rm-portfolio-content"><div class="empty">Run an assessment first.</div></div>
  </div>

  <div id="page-rm-repair" class="page">
    <div class="section-header"><div class="section-title">Suitability Repair</div></div>
    <div id="rm-repair-content"><div class="empty">Run an assessment first.</div></div>
  </div>

  <div id="page-rm-notes" class="page">
    <div class="section-header"><div class="section-title">RM Justification Note</div></div>
    <div id="rm-notes-content"><div class="empty">Run an assessment first.</div></div>
  </div>

  <div id="page-rm-audit" class="page">
    <div class="section-header"><div class="section-title">Audit Trail</div></div>
    <div class="card"><div id="audit-table"></div></div>
  </div>

  <div id="page-alerts" class="page">
    <div class="section-header"><div class="section-title">Risk Alerts</div><button class="btn btn-secondary btn-sm" onclick="loadAlerts()">Refresh Alerts</button></div>
    <div id="alerts-content"><div class="empty">No alerts yet.</div></div>
  </div>
  `;

  // Populate customer selects
  const sel = $('rm-sel-cust');
  CUSTOMERS.forEach(c => { const o = document.createElement('option'); o.value=c.id; o.textContent=`${c.id} — ${c.name} (${c.risk_appetite})`; sel.appendChild(o); });
  SELECTED_CUSTOMER = CUSTOMERS[0];
  updateRMCustInfo();
  setTimeout(() => { if(window._plotlyReady) livePayoff(); else document.addEventListener('plotlyready', livePayoff, {once:true}); }, 200);
}


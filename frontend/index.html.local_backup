    <div class="disclaimer">FinVision provides decision support, not investment advice. Historical results are not predictions. RM owns the final decision.</div>
    <div class="grid-4" id="rm-kpis"></div>
    <div class="card mt14"><div class="card-title">Customer Overview</div><div id="rm-cust-table"></div></div>
  </div>

  <div id="page-rm-customers" class="page">
    <div class="section-header">
      <div>
        <div class="section-title">Client Portfolio Directory</div>
        <div class="section-sub">Manage client risk mandates, asset allocations, exposures, and suitability dossiers</div>

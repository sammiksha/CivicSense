<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FinVision — Understand Before You Invest</title>
<meta name="description" content="FinVision: Explainable structured-product suitability platform. Understand structured financial products before you invest.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script>
(function(){
  function loadScript(src,cb){var s=document.createElement('script');s.src=src;s.onload=cb;s.onerror=function(){if(cb)cb();};document.head.appendChild(s);}
  loadScript('/plotly.min.js',function(){
    if(typeof Plotly==='undefined')loadScript('https://cdn.plot.ly/plotly-2.35.2.min.js',function(){window._plotlyReady=true;document.dispatchEvent(new Event('plotlyready'))});
    else{window._plotlyReady=true;document.dispatchEvent(new Event('plotlyready'));}
  });
})();
</script>
<style>
:root {
  --bg: #f0f2f7;
  --card: #ffffff;
  --ink: #0f172a;
  --ink2: #334155;
  --mut: #64748b;
  --line: #e2e8f0;
  --pri: #1e40af;
  --pri-d: #1e3a8a;
  --pri-l: #dbeafe;
  --ok: #15803d;
  --ok-l: #dcfce7;
  --rev: #b45309;
  --rev-l: #fef3c7;
  --bad: #b91c1c;
  --bad-l: #fee2e2;
  --nav-w: 220px;
  --header-h: 56px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.5}

/* ── Login ── */
#login-screen {
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,#1e3a8a 0%,#1e40af 50%,#1d4ed8 100%);
}
.login-box {
  background:#fff;border-radius:16px;padding:40px;width:100%;max-width:440px;
  box-shadow:0 20px 60px rgba(0,0,0,0.25);
}
.login-logo { text-align:center;margin-bottom:28px }
.login-logo .logo-name { font-size:26px;font-weight:700;color:var(--pri);letter-spacing:-0.5px }
.login-logo .logo-tagline { font-size:13px;color:var(--mut);margin-top:4px }
.login-tabs { display:flex;gap:8px;margin-bottom:24px }
.login-tab { flex:1;padding:9px;border-radius:8px;border:2px solid var(--line);background:#fff;cursor:pointer;font:500 13px 'Inter',sans-serif;color:var(--mut);transition:.15s }
.login-tab.active { border-color:var(--pri);color:var(--pri);background:var(--pri-l) }
.login-field label { display:block;font-size:12px;font-weight:500;color:var(--ink2);margin-bottom:5px }
.login-field input { width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;font:inherit;font-size:14px;outline:none;transition:.15s }
.login-field input:focus { border-color:var(--pri) }
.login-field { margin-bottom:14px }
.btn-login { width:100%;padding:12px;background:var(--pri);color:#fff;border:0;border-radius:8px;font:600 14px 'Inter',sans-serif;cursor:pointer;margin-top:6px;transition:.15s }
.btn-login:hover { background:var(--pri-d) }
.demo-creds { background:#f8faff;border-radius:8px;padding:12px;margin-top:16px;font-size:12px }
.demo-creds b { color:var(--pri);display:block;margin-bottom:6px }
.demo-creds span { color:var(--mut) }
.login-err { color:var(--bad);font-size:12px;margin-top:8px;display:none }

/* ── App Shell ── */
#app-shell { display:none;min-height:100vh }
.top-bar {
  position:fixed;top:0;left:0;right:0;height:var(--header-h);z-index:100;
  background:#fff;border-bottom:1px solid var(--line);
  display:flex;align-items:center;padding:0 20px;gap:16px;
}
.top-logo { font-size:17px;font-weight:700;color:var(--pri);letter-spacing:-0.3px;flex:0 0 auto }
.top-logo span { font-weight:300;color:var(--mut);font-size:12px;display:block;line-height:1 }
.top-bar-right { margin-left:auto;display:flex;align-items:center;gap:12px }
.top-user { font-size:13px;color:var(--ink2);display:flex;align-items:center;gap:8px }
.role-badge { font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px;background:var(--pri-l);color:var(--pri) }
.role-badge.customer { background:#f0fdf4;color:var(--ok) }
.btn-icon { background:none;border:1px solid var(--line);border-radius:6px;cursor:pointer;padding:6px 10px;font-size:12px;color:var(--mut);display:flex;align-items:center;gap:4px }
.btn-icon:hover { background:var(--bg) }
.alert-bell { position:relative;cursor:pointer;background:none;border:1px solid var(--line);border-radius:6px;padding:6px 10px }
.alert-count { position:absolute;top:-6px;right:-6px;background:var(--bad);color:#fff;border-radius:10px;font-size:10px;font-weight:700;padding:1px 5px;min-width:16px;text-align:center }

/* ── Nav Sidebar ── */
.sidebar {
  position:fixed;top:var(--header-h);left:0;bottom:0;width:var(--nav-w);
  background:#fff;border-right:1px solid var(--line);overflow-y:auto;z-index:50;padding:12px 0;
}
.nav-section-label { font-size:10px;font-weight:600;color:var(--mut);text-transform:uppercase;letter-spacing:.8px;padding:10px 16px 4px }
.nav-item { display:flex;align-items:center;gap:10px;padding:8px 16px;cursor:pointer;color:var(--ink2);border-radius:0;transition:.1s;font-size:13px;border-left:3px solid transparent }
.nav-item:hover { background:var(--bg);color:var(--pri) }
.nav-item.active { background:var(--pri-l);color:var(--pri);font-weight:500;border-left-color:var(--pri) }
.nav-item .nav-icon { width:16px;text-align:center;font-size:14px }

/* ── Main Content ── */
.main-content { margin-left:var(--nav-w);margin-top:var(--header-h);padding:20px;min-height:calc(100vh - var(--header-h)) }

/* ── Cards ── */
.card { background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:14px }
.card-title { font-size:13px;font-weight:600;color:var(--ink);margin-bottom:14px;display:flex;align-items:center;gap:8px }
.card-title .badge-sm { font-size:10px;font-weight:500;padding:2px 6px;border-radius:4px }
.grid-2 { display:grid;grid-template-columns:1fr 1fr;gap:14px }
.grid-3 { display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px }
.grid-4 { display:grid;grid-template-columns:repeat(4,1fr);gap:12px }

/* ── KPI Cards ── */
.kpi { background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px 18px }
.kpi-label { font-size:11px;color:var(--mut);font-weight:500;text-transform:uppercase;letter-spacing:.5px }
.kpi-value { font-size:24px;font-weight:700;color:var(--ink);margin-top:4px;letter-spacing:-0.5px }
.kpi-sub { font-size:12px;color:var(--mut);margin-top:2px }

/* ── Status Badges ── */
.badge { display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600 }
.badge.SUITABLE { background:var(--ok-l);color:var(--ok) }
.badge.REVIEW { background:var(--rev-l);color:var(--rev) }
.badge.MISMATCH { background:var(--bad-l);color:var(--bad) }
.badge.INFO { background:#eff6ff;color:#1d4ed8 }
.badge.WARNING { background:var(--rev-l);color:var(--rev) }
.badge.HIGH { background:var(--bad-l);color:var(--bad) }

/* ── Tables ── */
table { width:100%;border-collapse:collapse }
th,td { padding:8px 10px;text-align:left;border-bottom:1px solid var(--line);font-size:13px }
th { font-size:11px;font-weight:600;color:var(--mut);text-transform:uppercase;letter-spacing:.5px;background:var(--bg) }
tr:last-child td { border-bottom:0 }
tr:hover td { background:#fafbff }

/* ── Forms ── */
.form-group { margin-bottom:12px }
.form-group label { display:block;font-size:12px;font-weight:500;color:var(--ink2);margin-bottom:5px }
.form-group input,.form-group select,.form-group textarea {
  width:100%;padding:8px 10px;border:1.5px solid var(--line);border-radius:6px;font:inherit;font-size:13px;outline:none;transition:.15s
}
.form-group input:focus,.form-group select:focus { border-color:var(--pri) }
.form-group textarea { resize:vertical;min-height:60px }
.form-row { display:grid;grid-template-columns:1fr 1fr;gap:10px }

/* ── Buttons ── */
.btn { padding:8px 16px;border-radius:6px;border:0;cursor:pointer;font:500 13px 'Inter',sans-serif;transition:.15s;display:inline-flex;align-items:center;gap:6px }
.btn-primary { background:var(--pri);color:#fff }
.btn-primary:hover { background:var(--pri-d) }
.btn-secondary { background:var(--bg);color:var(--ink2);border:1px solid var(--line) }
.btn-secondary:hover { background:var(--line) }
.btn-sm { padding:5px 10px;font-size:12px }
.btn-full { width:100%;justify-content:center }
.btn-danger { background:var(--bad-l);color:var(--bad) }

/* ── Alerts ── */
.alert-item { border-left:3px solid;border-radius:6px;padding:10px 12px;margin-bottom:8px;font-size:13px }
.alert-item.HIGH { border-color:var(--bad);background:var(--bad-l) }
.alert-item.WARNING { border-color:var(--rev);background:var(--rev-l) }
.alert-item.INFO { border-color:var(--pri);background:#eff6ff }
.alert-title { font-weight:600;margin-bottom:3px }
.alert-msg { color:var(--ink2);font-size:12px }
.alert-action { font-size:11px;color:var(--mut);margin-top:4px;font-style:italic }

/* ── Ladder ── */
.ladder-row { display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid var(--line) }
.ladder-shock { width:50px;font-size:12px;font-weight:500;color:var(--ink2) }
.ladder-bar-wrap { flex:1;height:14px;background:var(--bg);border-radius:3px;overflow:hidden }
.ladder-bar { height:100%;border-radius:3px;transition:.3s }
.ladder-loss { width:60px;font-size:12px;color:var(--mut);text-align:right }
.ladder-status { width:80px;text-align:right }

/* ── Chat ── */
.chat-box { height:240px;overflow-y:auto;border:1px solid var(--line);border-radius:6px;padding:10px;background:#fafbff;margin-bottom:8px;display:flex;flex-direction:column;gap:8px }
.chat-msg { max-width:85%;padding:8px 12px;border-radius:8px;font-size:13px;line-height:1.5 }
.chat-msg.user { background:var(--pri);color:#fff;align-self:flex-end;border-radius:8px 8px 2px 8px }
.chat-msg.bot { background:#fff;border:1px solid var(--line);align-self:flex-start;border-radius:8px 8px 8px 2px }
.chat-msg.tool-trace { font-size:11px;color:var(--mut);background:transparent;border:0;padding:0 }
.chat-input-row { display:flex;gap:6px }
.chat-input-row input { flex:1;padding:8px 10px;border:1.5px solid var(--line);border-radius:6px;font:inherit;font-size:13px;outline:none }
.chat-input-row input:focus { border-color:var(--pri) }


/* ── Loading/Empty states ── */
.loading { text-align:center;padding:40px;color:var(--mut);font-size:13px }
.loading::after { content:'';display:inline-block;width:16px;height:16px;border:2px solid var(--line);border-top-color:var(--pri);border-radius:50%;animation:spin .8s linear infinite;vertical-align:middle;margin-left:8px }
@keyframes spin { to { transform:rotate(360deg) } }
.empty { text-align:center;padding:40px;color:var(--mut);font-size:13px }

/* ── Disclaimer bar ── */
.disclaimer { background:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:8px 12px;font-size:11px;color:#92400e;margin-bottom:12px }

/* ── Misc ── */
.mut { color:var(--mut) }
.text-sm { font-size:12px }
.text-xs { font-size:11px }
.fw6 { font-weight:600 }
.mt4 { margin-top:4px }
.mt8 { margin-top:8px }
.mt14 { margin-top:14px }
.flex { display:flex }
.items-center { align-items:center }
.gap-8 { gap:8px }
.gap-14 { gap:14px }
.mb0 { margin-bottom:0 }
.page { display:none }
.page.active { display:block }
.two-col { display:grid;grid-template-columns:340px 1fr;gap:14px }
@media(max-width:900px){.two-col,.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}.sidebar{display:none}.main-content{margin-left:0}}

/* ── Highlight for warnings ── */
.warn-text { color:var(--bad);font-weight:500 }
.ok-text { color:var(--ok);font-weight:500 }
.info-text { color:var(--pri);font-weight:500 }

/* ── Section headers ── */
.section-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:16px }
.section-title { font-size:18px;font-weight:600;color:var(--ink) }
.section-sub { font-size:13px;color:var(--mut);margin-top:2px }

/* ── Regime grid ── */
.regime-card { border-radius:8px;padding:12px;border:1px solid var(--line) }
.regime-card.bull { background:#f0fdf4 }
.regime-card.normal { background:#f0f9ff }
.regime-card.mild { background:#fefce8 }
.regime-card.severe { background:#fff7ed }
.regime-card.crash { background:#fff1f2 }

/* ── Simulator Styling ── */
.sim-range-wrap { position:relative;margin:10px 0 6px }
.sim-range { width:100%;height:8px;border-radius:4px;outline:none;background:#e2e8f0;-webkit-appearance:none;cursor:pointer }
.sim-range::-webkit-slider-thumb { -webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--pri);cursor:pointer;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.2);transition:.15s }
.sim-range::-webkit-slider-thumb:hover { transform:scale(1.15);background:var(--pri-d) }
.sim-chip-btn { padding:5px 12px;border-radius:16px;border:1px solid var(--line);background:#fff;font-size:11px;font-weight:500;cursor:pointer;transition:.15s;color:var(--ink2) }
.sim-chip-btn:hover { background:var(--pri-l);border-color:var(--pri);color:var(--pri) }
.sim-chip-btn.active { background:var(--pri);border-color:var(--pri);color:#fff }
.sim-spectrum-bar { height:18px;border-radius:9px;background:linear-gradient(to right, #ef4444 0%, #ef4444 30%, #f59e0b 30%, #3b82f6 60%, #10b981 60%, #10b981 100%);position:relative;margin:16px 0 10px;box-shadow:inset 0 1px 3px rgba(0,0,0,0.15) }
.sim-spectrum-pin { position:absolute;top:-6px;bottom:-6px;width:4px;background:#0f172a;border-radius:2px;box-shadow:0 0 6px rgba(0,0,0,0.5);transform:translateX(-50%);transition:left .1s ease }
.sim-spectrum-pin::after { content:'▼';position:absolute;top:-14px;left:-4px;font-size:10px;color:#0f172a }
.sim-outcome-hero { border-radius:12px;padding:18px;margin-bottom:14px;transition:background .2s }
.sim-outcome-hero.safe { background:linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);border:1.5px solid #86efac }
.sim-outcome-hero.breached { background:linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);border:1.5px solid #fca5a5 }
.sim-expl-card { background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:12px }
.sim-expl-title { font-size:13px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:8px;margin-bottom:8px }
.sim-compare-table th { background:#f8fafc;font-size:11px;font-weight:600;padding:8px }
.sim-compare-table td { font-size:12px;padding:8px }
.sim-compare-table tr.highlight { background:#f0fdf4;font-weight:600 }
</style>
</head>
<body>

<!-- ══════════════ LOGIN ══════════════ -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">
      <div class="logo-name">FinVision</div>
      <div class="logo-tagline">Understand Before You Invest</div>
    </div>
    <div class="login-tabs">
      <button class="login-tab active" id="tab-rm" onclick="switchLoginTab('rm')">Relationship Manager</button>
      <button class="login-tab" id="tab-customer" onclick="switchLoginTab('customer')">Customer</button>
    </div>
    <div class="login-field">
      <label>Email</label>
      <input type="email" id="login-email" placeholder="Enter your email" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <div class="login-field">
      <label>Password</label>
      <input type="password" id="login-password" placeholder="Enter your password" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <div id="login-err" class="login-err">Invalid credentials. Please try again.</div>
    <button class="btn-login" onclick="doLogin()">Sign In</button>
    <div class="demo-creds" id="demo-creds-rm">
      <b>Demo credentials (RM)</b>
      <span>Email: rm@finvision.demo<br>Password: RM@123</span>
    </div>
    <div class="demo-creds" id="demo-creds-customer" style="display:none">
      <b>Demo credentials (Customer)</b>
      <span>Email: customer@finvision.demo<br>Password: Customer@123</span>
    </div>
  </div>
</div>

<!-- ══════════════ APP SHELL ══════════════ -->
<div id="app-shell">
  <!-- Top bar -->
  <div class="top-bar">
    <div class="top-logo">FinVision <span>Understand Before You Invest</span></div>
    <div class="top-bar-right">
      <button class="alert-bell btn-icon" onclick="navTo('alerts')">
        🔔 <span id="alert-count-badge" class="alert-count" style="display:none">0</span>
      </button>
      <div class="top-user">
        <span id="top-user-name">—</span>
        <span id="top-role-badge" class="role-badge">—</span>
      </div>
      <button class="btn-icon" onclick="doLogout()">Sign Out</button>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <!-- filled by JS based on role -->
  </div>

  <!-- Main content -->
  <div class="main-content" id="main-content">
    <!-- pages injected by JS -->
  </div>
</div>

<script>
'use strict';
// ══════════════ GLOBALS ══════════════
let AUTH = null; // {token, user}
let CUSTOMERS = [];
let SELECTED_CUSTOMER = null;
let LAST_ASSESSMENT = null;
let LAST_AUDIT_ID = null;
let SESSION_CHAT_HISTORY = [];
let LAST_CUST_QUERY = '';

const $ = id => document.getElementById(id);
const api = async (p, b, method) => {
  const opts = { headers: {'Content-Type': 'application/json'} };
  if (AUTH) opts.headers['Authorization'] = 'Bearer ' + AUTH.token;
  if (b !== undefined) { opts.method = method || 'POST'; opts.body = JSON.stringify(b); }
  const r = await fetch(p, opts);
  if (!r.ok) { const t = await r.text(); throw new Error(t); }
  return r.json();
};
const fmt = x => x == null ? 'n/a' : (+x).toLocaleString('en-IN', {maximumFractionDigits: 2});
const fmtInr = x => x == null ? 'n/a' : '₹' + Math.abs(Math.round(x)).toLocaleString('en-IN');
const badge = s => `<span class="badge ${s}">${s}</span>`;
const prod = () => {
  const t = $('p-type')?.value || 'ELN';
  const o = {
    product_type: t,
    underlying: $('p-under')?.value || 'NIFTY 50',
    tenor_months: +($('p-tenor')?.value || 12),
    coupon_pct: +($('p-coupon')?.value || 12),
    strike_pct: +($('p-strike')?.value || 100),
    notional: +($('p-notional')?.value || 1000000),
    protection_pct: +($('p-prot')?.value || 90),
    participation_pct: +($('p-part')?.value || 100),
  };
  if (t === 'ELN' || t === 'DCD') o.barrier_pct = +($('p-barrier')?.value || 70);
  return o;
};

// ══════════════ AUTH ══════════════
function switchLoginTab(role) {
  ['rm','customer'].forEach(r => {
    $('tab-'+r).classList.toggle('active', r === role);
    $('demo-creds-'+r).style.display = r === role ? 'block' : 'none';
  });
  if (role === 'rm') { $('login-email').value = 'rm@finvision.demo'; $('login-password').value = 'RM@123'; }
  else { $('login-email').value = 'customer@finvision.demo'; $('login-password').value = 'Customer@123'; }
}

async function doLogin() {
  $('login-err').style.display = 'none';
  try {
    const res = await api('/api/auth/login', {email: $('login-email').value.trim(), password: $('login-password').value});
    AUTH = res;
    localStorage.setItem('fv_token', res.token);
    localStorage.setItem('fv_user', JSON.stringify(res.user));
    await bootApp();
  } catch(e) {
    $('login-err').style.display = 'block';
  }
}

async function doLogout() {
  if (AUTH) await api('/api/auth/logout', {}).catch(()=>{});
  AUTH = null;
  localStorage.removeItem('fv_token');
  localStorage.removeItem('fv_user');
  $('login-screen').style.display = 'flex';
  $('app-shell').style.display = 'none';
}

// ══════════════ BOOT ══════════════
async function bootApp() {
  $('login-screen').style.display = 'none';
  $('app-shell').style.display = 'block';
  const u = AUTH.user;
  $('top-user-name').textContent = u.name;
  $('top-role-badge').textContent = u.role === 'rm' ? 'RM' : 'Customer';
  $('top-role-badge').className = 'role-badge' + (u.role === 'customer' ? ' customer' : '');

  CUSTOMERS = await api('/api/v1/customers');

  if (u.role === 'rm') {
    buildSidebar('rm');
    buildRMPages();
    navTo('rm-dashboard');
    loadRMDashboard();
  } else {
    buildSidebar('customer');
    buildCustomerPages();
    SELECTED_CUSTOMER = CUSTOMERS.find(c => c.id === u.customer_id) || CUSTOMERS[0];
    navTo('cust-dashboard');
    loadCustomerDashboard();
  }
  pollAlerts();
}

async function tryAutoLogin() {
  const token = localStorage.getItem('fv_token');
  const user = localStorage.getItem('fv_user');
  if (!token || !user) return;
  AUTH = { token, user: JSON.parse(user) };
  try {
    await api('/api/auth/me');
    await bootApp();
  } catch(e) {
    AUTH = null;
    localStorage.removeItem('fv_token');
    localStorage.removeItem('fv_user');
  }
}

// ══════════════ SIDEBAR ══════════════
const RM_NAV = [
  {id:'rm-dashboard', icon:'⬛', label:'Dashboard'},
  {id:'rm-customers', icon:'👥', label:'Customers'},
  {id:'rm-studio', icon:'🏗', label:'Product Studio'},
  {id:'rm-analysis', icon:'📊', label:'Assessment'},
  {id:'rm-stress', icon:'⚡', label:'Stress & Regime'},
  {id:'rm-portfolio', icon:'📁', label:'Portfolio Impact'},
  {id:'rm-repair', icon:'🔧', label:'Repair'},
  {id:'rm-notes', icon:'📄', label:'RM Notes'},
  {id:'rm-audit', icon:'🔍', label:'Audit Trail'},
  {id:'alerts', icon:'🔔', label:'Risk Alerts'},
];
const CUST_NAV = [
  {id:'cust-dashboard', icon:'🏠', label:'Dashboard'},
  {id:'cust-simulator', icon:'🎛️', label:'Risk & Return Playground'},
  {id:'cust-profile', icon:'👤', label:'My Profile'},
  {id:'cust-portfolio', icon:'📁', label:'My Portfolio'},
  {id:'cust-analysis', icon:'📊', label:'Product Analysis'},
  {id:'cust-payoff', icon:'📈', label:'Payoff & Scenarios'},
  {id:'cust-stress', icon:'⚡', label:'Stress Analysis'},
  {id:'cust-impact', icon:'💸', label:'Portfolio Impact'},
  {id:'alerts', icon:'🔔', label:'Risk Alerts'},
  {id:'cust-copilot', icon:'💬', label:'AI Assistant'},
];

function buildSidebar(role) {
  const nav = role === 'rm' ? RM_NAV : CUST_NAV;
  $('sidebar').innerHTML = nav.map(n =>
    `<div class="nav-item" id="nav-${n.id}" onclick="navTo('${n.id}')">
      <span class="nav-icon">${n.icon}</span>${n.label}
    </div>`
  ).join('');
}

function navTo(id) {
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  const ni = $('nav-'+id);
  if (ni) ni.classList.add('active');
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const pg = $('page-'+id);
  if (pg) pg.classList.add('active');
  if (id === 'rm-customers') loadRMCustomers();
  if (id === 'cust-simulator') loadSimulatorPage();
  if (id === 'alerts') loadAlerts();
  if (id === 'rm-audit') loadAuditTable();
  if (id === 'cust-portfolio') loadCustomerPortfolio();
  if (id === 'cust-profile') loadCustomerProfile();
  // Customer analysis pages — load on first visit
  if (id === 'cust-analysis') runCustAnalysis();
  if (id === 'cust-payoff') loadCustPayoff();
  if (id === 'cust-stress') loadCustStress();
  if (id === 'cust-impact') loadCustPortfolioImpact();
}

// ══════════════ PAGE BUILDERS ══════════════
function buildRMPages() {
  $('main-content').innerHTML = `
  <div id="page-rm-dashboard" class="page">

    <div class="card">
      <div class="card-title">Personal Information</div>
      <table>
        <tr><td class="mut">Name</td><td><b>${c.name}</b></td></tr>
        <tr><td class="mut">Customer ID</td><td>${c.id}</td></tr>
        <tr><td class="mut">Email</td><td>${c.email||'—'}</td></tr>
        <tr><td class="mut">Phone</td><td>${c.phone||'—'}</td></tr>
        <tr><td class="mut">City</td><td>${c.city||'—'}</td></tr>
        <tr><td class="mut">KYC Status</td><td>${c.kyc_status||'—'}</td></tr>
        <tr><td class="mut">Segment</td><td>${c.segment||'HNI'}</td></tr>

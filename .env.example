# FinVision Environment Configuration
# Copy this file to .env in the project root before running the app.

# Real LLM API configuration (supports OpenAI, Anthropic, Gemini, Groq)
# You can set any of these:
LLM_API_KEY=
LLM_PROVIDER=openai   # "openai", "anthropic", "gemini", "groq"
LLM_MODEL=gpt-4o-mini  # or "claude-sonnet-5-5", "gemini-1.5-flash", "llama-3.1-70b-versatile"
# LLM_BASE_URL=        # optional custom endpoint for local or private models

# Or provider-specific keys:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Toggle live market data fetching from Yahoo Finance.
STRUCTURAAI_LIVE_DATA=0
YAHOO_NIFTY50_SYMBOL=^NSEI
YAHOO_USDINR_SYMBOL=USDINR=X
YAHOO_START_DATE=2007-09-01

# Monte Carlo simulation paths
MC_PATHS=10000
MC_SEED=42

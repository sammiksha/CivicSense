# Copy this file to .env in the project root before running the app.
# Leave ANTHROPIC_API_KEY empty to run in deterministic OFFLINE mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Toggle live market data fetching from Yahoo Finance.
# Set to 1/true/yes to fetch data when cached files do not exist.
STRUCTURAAI_LIVE_DATA=0
YAHOO_NIFTY50_SYMBOL=^NSEI
YAHOO_USDINR_SYMBOL=USDINR=X
YAHOO_START_DATE=2007-09-01

# Monte Carlo and app tuning
MC_PATHS=10000
MC_SEED=42

# Optional override for the market / knowledge directory locations.
# DATA_DIR=/absolute/path/to/project/data
# DB_PATH=/absolute/path/to/structuraai.db
